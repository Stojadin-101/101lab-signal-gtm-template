// 101lab Signal - Consent Mode v2
// À déclencher sur « Consent Initialization - All Pages ».

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const getCookieValues = require('getCookieValues');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const gtagSet = require('gtagSet');
const makeNumber = require('makeNumber');
const JSON = require('JSON');
const logToConsole = require('logToConsole');

// URL exacte et figée du script : doit correspondre à la permission « Injecte des scripts ».
// TODO : hébergement à choisir ; une nouvelle version du script = une nouvelle version du template.
const SCRIPT_URL = 'https://cdn.101-lab.com/signal/2.0.1/101lab-signal.min.js';
const COOKIE_NAME = '__101labSignalState';
// Ordre des signaux dans le cookie (voir src/consent.js).
const COOKIE_ORDER = [
  'ad_storage',
  'ad_user_data',
  'ad_personalization',
  'analytics_storage',
  'functionality_storage',
  'personalization_storage',
  'security_storage'
];

// Pays où le bandeau s'affiche (champ « regions »), normalisés en majuscules.
const parseRegions = (value) => {
  const out = [];
  const parts = value ? value.split(',') : [];
  for (let i = 0; i < parts.length; i++) {
    const code = parts[i].trim().toUpperCase();
    if (code.length === 2) out.push(code);
  }
  return out;
};
const regions = parseRegions(data.regions);

// 1. Valeurs par défaut.
//    - Pays listés (ou partout si la liste est vide) : tout refusé sauf la sécurité.
//    - Reste du monde : tout accordé (le script n'y affiche pas de bandeau).
//    Google applique la valeur régionale en priorité, quel que soit l'ordre des appels.
const waitForUpdate = makeNumber(data.waitForUpdate);
const consentDefaults = (value) => ({
  ad_storage: value,
  ad_user_data: value,
  ad_personalization: value,
  analytics_storage: value,
  functionality_storage: value,
  personalization_storage: value,
  security_storage: 'granted'
});
const deniedDefaults = consentDefaults('denied');
deniedDefaults.wait_for_update = waitForUpdate >= 0 ? waitForUpdate : 500;
if (regions.length) {
  deniedDefaults.region = regions;
  setDefaultConsentState(deniedDefaults);
  setDefaultConsentState(consentDefaults('granted'));
} else {
  setDefaultConsentState(deniedDefaults);
}
if (data.adsDataRedaction) gtagSet('ads_data_redaction', true);
if (data.urlPassthrough) gtagSet('url_passthrough', true);

// 2. Choix déjà mémorisé : on le réapplique et on n'affiche pas le bandeau.
const readStoredState = () => {
  const values = getCookieValues(COOKIE_NAME);
  const parts = values && values.length ? values[0].split('|') : [];
  if (parts.length !== COOKIE_ORDER.length) return null;
  const state = {};
  for (let i = 0; i < COOKIE_ORDER.length; i++) {
    state[COOKIE_ORDER[i]] = parts[i] === '1' ? 'granted' : 'denied';
  }
  return state;
};

// 3. Configuration transmise au script (lue par window.__101labSignalConfig).
const buildConfig = () => {
  const config = {
    privacyPolicyUrl: data.privacyPolicyUrl,
    regions: regions,
    poweredBy: data.poweredBy !== false,
    colors: {},
    fonts: {},
    texts: { primary: {} },
    services: []
  };

  if (data.logoMode === 'none') config.logo = false;
  else if (data.logoMode === 'image') config.logo = { src: data.logoUrl, alt: data.logoAlt || '' };

  if (data.colorAccent) config.colors.accent = data.colorAccent;
  if (data.colorAccentHover) config.colors.accentHover = data.colorAccentHover;
  if (data.colorInk) config.colors.ink = data.colorInk;
  if (data.fontSans) config.fonts.sans = data.fontSans;

  if (data.textEyebrow) config.texts.primary.eyebrow = data.textEyebrow;
  if (data.textTitle) config.texts.primary.title = data.textTitle;
  if (data.textIntro) config.texts.primary.intro = data.textIntro;

  const rows = data.services || [];
  for (let i = 0; i < rows.length; i++) {
    config.services.push({
      name: rows[i].name,
      category: rows[i].category,
      duration: makeNumber(rows[i].duration),
      description: rows[i].description
    });
  }

  if (data.advancedJson) {
    const advanced = JSON.parse(data.advancedJson);
    if (advanced) config.advanced = advanced;
    else logToConsole('101lab Signal : configuration avancée ignorée (JSON invalide).');
  }
  return config;
};

const stored = readStoredState();
if (stored) {
  updateConsentState(stored);
  data.gtmOnSuccess();
} else {
  setInWindow('__101labSignalConfig', buildConfig(), true);
  injectScript(SCRIPT_URL, data.gtmOnSuccess, data.gtmOnFailure, SCRIPT_URL);
}


